# ============================================================================
# re-align — environment variables
# Copy to .env locally. In production (Railway or any VPS) set the same keys
# in the host's environment panel. Never commit the real values.
# ============================================================================

# ------------------------------------------------------------------ core --
APP_ENV=production                 # development | staging | production
APP_NAME=re-align
APP_BASE_URL=https://your-app.up.railway.app
# openssl rand -hex 32
APP_SECRET_KEY=CHANGE-ME-32-BYTES-MINIMUM-CHANGE-ME-PLEASE
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=CHANGE-ME-FERNET-KEY
DEBUG=false

# -------------------------------------------------------------- database --
# The default SQLite is for local trials only; production needs Postgres.
# Paste your managed-Postgres connection string (Neon etc.) — both
# `postgres://` and `postgresql://` are accepted and converted to asyncpg.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ------------------------------------------------------------------- LLM --
# Leave on `mock` to demo without paying for an API key.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_THINKING_MODEL=gpt-4o
OPENAI_DECISION_MODEL=gpt-4o-mini

# ------------------------------------------------------------- security --
FORCE_HTTPS=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true
SSRF_PROTECTION=true
SECURITY_REPORT_EMAIL=security@yourdomain.com
# Shared secret for GET /api/v1/cron/tick (any external cron may call it).
# openssl rand -hex 24
CRON_SECRET=CHANGE-ME-CRON-SECRET

# -------------------------------------------------------------- billing --
# none | paymob | kashier | fawry | moyasar | stripe | manual
BILLING_PROVIDER=none

# -------------------------------------------------------------- channels --
# All optional. Until they are set, publishes stay in the approval queue.
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ------------------------------------------------------------- admin boot --
# First admin account created on an empty database (change after first login).
ADMIN_EMAIL=admin@re-align.app
ADMIN_PASSWORD=CHANGE-ME-ADMIN-PASSWORD
